generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String   @id @default(cuid())
  email               String   @unique
  name                String?
  passwordHash        String
  role                String   @default("VIEWER")
  isActive            Boolean  @default(true)
  rememberToken       String?  @unique
  tokenExpiry         DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  createdRequests     Request[] @relation("RequestCreatedBy")
}

model Company {
  id          String     @id @default(cuid())
  name        String     @unique
  createdAt   DateTime   @default(now())
  logoUrl     String?
  departments Department[]
}

model Department {
  id       String  @id @default(cuid())
  name     String
  companyId String
  company  Company @relation(fields: [companyId], references: [id])
  requests Request[]

  @@unique([companyId, name])
}

model Request {
  id                String    @id @default(cuid())
  requestNo         Int       @unique @default(autoincrement())
  requestOwner      String
  candidateType     String
  quantity          String?
  notes             String?
  currentNote       String?
  statusId          String?
  createdAt         DateTime  @default(now())
  deadline          DateTime?
  departmentId      String
  createdById       String?
  adessoDuration    DateTime?
  domainId          String?
  candidates        Candidate[]
  department        Department  @relation(fields: [departmentId], references: [id])
  createdBy         User?       @relation("RequestCreatedBy", fields: [createdById], references: [id])
  status            RequestStatus? @relation(fields: [statusId], references: [id])
  domain            Domain?     @relation(fields: [domainId], references: [id])
}

model Candidate {
  id                String    @id @default(cuid())
  requestId         String?
  domain            String?
  requestDetails    String?
  candidateName     String
  source            String?
  processStatusId   String?
  cost              String?
  startDate         DateTime?
  createdAt         DateTime  @default(now())
  clientName        String?
  request           Request?    @relation(fields: [requestId], references: [id], onDelete: Cascade)
  processStatus     ProcessStatus? @relation(fields: [processStatusId], references: [id])
}

model RequestStatus {
  id     String @id @default(cuid())
  name   String @unique
  order  Int    @default(0)
  ton    String @default("varsayilan")
  requests Request[]
}

model ProcessStatus {
  id     String @id @default(cuid())
  name   String @unique
  order  Int    @default(0)
  ton    String @default("varsayilan")
  candidates Candidate[]
}

model Domain {
  id          String   @id @default(cuid())
  name        String
  parentId    String?
  parent      Domain?  @relation("DomainHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children    Domain[] @relation("DomainHierarchy")
  requests    Request[]
  createdAt   DateTime @default(now())

  @@index([parentId])
}

model ReleaseNote {
  id        String   @id @default(cuid())
  version   String   @unique
  title     String
  body      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
